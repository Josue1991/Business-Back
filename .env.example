# Server Configuration
PORT=3005
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/business_logs
MONGODB_DB_NAME=business_logs

# Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_INDEX=business-logs

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=business-log-service
KAFKA_GROUP_ID=business-log-group
KAFKA_TOPIC_LOGS=business.logs

# RabbitMQ Configuration (Alternative)
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE=business_logs

# Log Retention
LOG_RETENTION_DAYS=30
LOG_ARCHIVE_ENABLED=true

# Security
API_KEY=your-api-key-here
CORS_ORIGIN=http://localhost:3000
